{"ast":null,"code":"import{create}from'zustand';import{persist}from'zustand/middleware';export const useAuthStore=create(persist(set=>({user:null,token:null,isAuthenticated:false,setAuth:(user,token)=>{localStorage.setItem('token',token);set({user,token,isAuthenticated:true});},logout:()=>{localStorage.removeItem('token');localStorage.removeItem('user');set({user:null,token:null,isAuthenticated:false});}}),{name:'auth-store',partialize:s=>({user:s.user,token:s.token,isAuthenticated:s.isAuthenticated})}));export const useCartStore=create((set,get)=>({cart:null,isOpen:false,setCart:cart=>set({cart}),openCart:()=>set({isOpen:true}),closeCart:()=>set({isOpen:false}),toggleCart:()=>set(s=>({isOpen:!s.isOpen})),getTotalItems:()=>{const cart=get().cart;if(!(cart!==null&&cart!==void 0&&cart.items))return 0;return cart.items.reduce((sum,item)=>sum+item.quantity,0);}}));","map":{"version":3,"names":["create","persist","useAuthStore","set","user","token","isAuthenticated","setAuth","localStorage","setItem","logout","removeItem","name","partialize","s","useCartStore","get","cart","isOpen","setCart","openCart","closeCart","toggleCart","getTotalItems","items","reduce","sum","item","quantity"],"sources":["F:/ecommerce-frontend/src/store/index.js"],"sourcesContent":["import { create } from 'zustand';\nimport { persist } from 'zustand/middleware';\n\nexport const useAuthStore = create(\n  persist(\n    (set) => ({\n      user: null,\n      token: null,\n      isAuthenticated: false,\n      setAuth: (user, token) => {\n        localStorage.setItem('token', token);\n        set({ user, token, isAuthenticated: true });\n      },\n      logout: () => {\n        localStorage.removeItem('token');\n        localStorage.removeItem('user');\n        set({ user: null, token: null, isAuthenticated: false });\n      },\n    }),\n    { name: 'auth-store', partialize: (s) => ({ user: s.user, token: s.token, isAuthenticated: s.isAuthenticated }) }\n  )\n);\n\nexport const useCartStore = create((set, get) => ({\n  cart: null,\n  isOpen: false,\n  setCart: (cart) => set({ cart }),\n  openCart: () => set({ isOpen: true }),\n  closeCart: () => set({ isOpen: false }),\n  toggleCart: () => set((s) => ({ isOpen: !s.isOpen })),\n  getTotalItems: () => {\n    const cart = get().cart;\n    if (!cart?.items) return 0;\n    return cart.items.reduce((sum, item) => sum + item.quantity, 0);\n  },\n}));\n"],"mappings":"AAAA,OAASA,MAAM,KAAQ,SAAS,CAChC,OAASC,OAAO,KAAQ,oBAAoB,CAE5C,MAAO,MAAM,CAAAC,YAAY,CAAGF,MAAM,CAChCC,OAAO,CACJE,GAAG,GAAM,CACRC,IAAI,CAAE,IAAI,CACVC,KAAK,CAAE,IAAI,CACXC,eAAe,CAAE,KAAK,CACtBC,OAAO,CAAEA,CAACH,IAAI,CAAEC,KAAK,GAAK,CACxBG,YAAY,CAACC,OAAO,CAAC,OAAO,CAAEJ,KAAK,CAAC,CACpCF,GAAG,CAAC,CAAEC,IAAI,CAAEC,KAAK,CAAEC,eAAe,CAAE,IAAK,CAAC,CAAC,CAC7C,CAAC,CACDI,MAAM,CAAEA,CAAA,GAAM,CACZF,YAAY,CAACG,UAAU,CAAC,OAAO,CAAC,CAChCH,YAAY,CAACG,UAAU,CAAC,MAAM,CAAC,CAC/BR,GAAG,CAAC,CAAEC,IAAI,CAAE,IAAI,CAAEC,KAAK,CAAE,IAAI,CAAEC,eAAe,CAAE,KAAM,CAAC,CAAC,CAC1D,CACF,CAAC,CAAC,CACF,CAAEM,IAAI,CAAE,YAAY,CAAEC,UAAU,CAAGC,CAAC,GAAM,CAAEV,IAAI,CAAEU,CAAC,CAACV,IAAI,CAAEC,KAAK,CAAES,CAAC,CAACT,KAAK,CAAEC,eAAe,CAAEQ,CAAC,CAACR,eAAgB,CAAC,CAAE,CAClH,CACF,CAAC,CAED,MAAO,MAAM,CAAAS,YAAY,CAAGf,MAAM,CAAC,CAACG,GAAG,CAAEa,GAAG,IAAM,CAChDC,IAAI,CAAE,IAAI,CACVC,MAAM,CAAE,KAAK,CACbC,OAAO,CAAGF,IAAI,EAAKd,GAAG,CAAC,CAAEc,IAAK,CAAC,CAAC,CAChCG,QAAQ,CAAEA,CAAA,GAAMjB,GAAG,CAAC,CAAEe,MAAM,CAAE,IAAK,CAAC,CAAC,CACrCG,SAAS,CAAEA,CAAA,GAAMlB,GAAG,CAAC,CAAEe,MAAM,CAAE,KAAM,CAAC,CAAC,CACvCI,UAAU,CAAEA,CAAA,GAAMnB,GAAG,CAAEW,CAAC,GAAM,CAAEI,MAAM,CAAE,CAACJ,CAAC,CAACI,MAAO,CAAC,CAAC,CAAC,CACrDK,aAAa,CAAEA,CAAA,GAAM,CACnB,KAAM,CAAAN,IAAI,CAAGD,GAAG,CAAC,CAAC,CAACC,IAAI,CACvB,GAAI,EAACA,IAAI,SAAJA,IAAI,WAAJA,IAAI,CAAEO,KAAK,EAAE,MAAO,EAAC,CAC1B,MAAO,CAAAP,IAAI,CAACO,KAAK,CAACC,MAAM,CAAC,CAACC,GAAG,CAAEC,IAAI,GAAKD,GAAG,CAAGC,IAAI,CAACC,QAAQ,CAAE,CAAC,CAAC,CACjE,CACF,CAAC,CAAC,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}